if(!is.null(FILTER_STATE)){
filtered_data <- filtered_data %>% filter(STATE %in% FILTER_STATE)
}
if(!is.null(FILTER_FIRES)){
filtered_data <- filtered_data %>% filter(FireName == FILTER_STATE)
}
if(!is.null(FILTER_FOREST)){
filtered_data <- filtered_data %>%
filter(stringr::str_detect(EVT_GP_N, stringr::regex(FILTER_FOREST, ignore_case = TRUE)))
}
data_list <- list("BroadConifer" = filtered_data)
} else if (RUN_MODE == "STRATIFIED"){
filtered_data <- cbi_data %>%
filter(stringr::str_detect(EVT_GP_N, stringr::regex(TARGET_FOREST_TYPES, ignore_case = TRUE)))
data_list <- split(filtered_data, filtered_data$EVT_GP_N)
}
# ==========================================
# CORES ANALYSIS RUNNER
# ==========================================
master_summary <- list()
schemes <- list(
"CBI_4"    = list(breaks = c(0.5, 1.5, 2.25),   levels = c("Unburned", "Low", "Moderate", "High")),
"CBI_3"    = list(breaks = c(1.25, 2.25),       levels = c("Unburned/Low", "Moderate", "High")),
"CBI_high" = list(breaks = c(2.25),             levels = c("low/mod", "high"))
)
for(forest_name in names(data_list)){
current_sub_df <- data_list[[forest_name]]
if(nrow(current_sub_df) < 15) next
for(s in indices){
# Prepare dynamic data for the loop
loop_df <- current_sub_df %>%
rename(sev_index = !!sym(s)) %>%
filter(!is.na(sev_index))
if(nrow(loop_df) < 10) next
# Regression model
mod <- lm(sev_index ~ poly(Cbi, 2, raw = TRUE), data = loop_df)
base_stats <- glance(mod)
# Evaluate each classification scheme
for(scheme_name in names(schemes)) {
cfg <- schemes[[scheme_name]]
# Calculate Thresholds
thresh_cbi <- data.frame(Cbi = cfg$breaks)
vals <- predict(mod, thresh_cbi)
# FIX: Run case_when INSIDE mutate to guarantee identical vector lengths
loop_df_classified <- loop_df %>%
mutate(predicted_sev = case_when(
scheme_name == "CBI_4" & sev_index < vals[1] ~ "Unburned",
scheme_name == "CBI_4" & sev_index >= vals[1] & sev_index < vals[2] ~ "Low",
scheme_name == "CBI_4" & sev_index >= vals[2] & sev_index < vals[3] ~ "Moderate",
scheme_name == "CBI_4" & sev_index >= vals[3] ~ "High",
scheme_name == "CBI_3" & sev_index < vals[1] ~ "Unburned/Low",
scheme_name == "CBI_3" & sev_index >= vals[1] & sev_index < vals[2] ~ "Moderate",
scheme_name == "CBI_3" & sev_index >= vals[2] ~ "High",
scheme_name == "CBI_high" & sev_index < vals[1] ~ "low/mod",
scheme_name == "CBI_high" & sev_index >= vals[1] ~ "high",
TRUE ~ NA_character_
))
# Confusion Matrix using the synchronized dataframe
conf_mat <- confusionMatrix(
factor(loop_df_classified$predicted_sev, levels = cfg$levels),
factor(loop_df_classified[[scheme_name]], levels = cfg$levels)
)
# Format the calculated thresholds into clean, readable text string
threshold_string <- case_when(
scheme_name == "CBI_4" ~ paste0(
"Unburned < ", round(vals[1], 1),
" | Low >= ",  round(vals[1], 1),
" | Mod >= ",  round(vals[2], 1),
" | High >= ", round(vals[3], 1)
),
scheme_name == "CBI_3" ~ paste0(
"Low/Unburned < ", round(vals[1], 1),
" | Mod >= ",      round(vals[1], 1),
" | High >= ",     round(vals[2], 1)
),
scheme_name == "CBI_high" ~ paste0(
"High >= ", round(vals[1], 1)
),
TRUE ~ NA_character_
)
# Extract stats, Accuracy and Kappa
stats_combined <- base_stats %>%
mutate(
forest_type = forest_name,
index = s,
classification = scheme_name,
n_plots = nrow(loop_df),
Accuracy = conf_mat$overall['Accuracy'],
Kappa = conf_mat$overall['Kappa'],
thresholds = threshold_string,
p_val_clean    = if_else(p.value < 0.0001, "< 0.0001", as.character(round(p.value, 4)))
) %>%
select(forest_type, index, classification, n_plots, r.squared, Accuracy, Kappa, p_val_clean, AIC, thresholds)
storage_key <- paste0(forest_name, "_", s, "_", scheme_name)
master_summary[[storage_key]] <- stats_combined
# Save individual Matrix output
safe_forest_name <- gsub("[^[:alnum:]]", "_", forest_name)
capture.output(conf_mat, file = file.path(output_dir, paste0(safe_forest_name, "_", s, "_", scheme_name, "_accuracy.txt")))
}
# PLOTTING Regressions
reg_plot <- ggplot(loop_df, aes(x = Cbi, y = sev_index)) +
geom_point(alpha = 0.4, color = "gray30") +
stat_smooth(method = "lm", formula = y ~ poly(x, 2), color = "firebrick") +
stat_regline_equation(label.y = max(loop_df$sev_index, na.rm=T) * 0.9) +
geom_vline(xintercept = 2.25, linetype = "dashed") +
labs(title = paste("Regression:", s), y = s, x = "Field CBI") +
theme_minimal() +
theme(text = element_text(family = "serif"))
ggsave(file.path(output_dir, paste0(RUN_MODE, "_", scheme_name, "_", s, ".png")), reg_plot)
}
}
# FINAL SUMMARY TABLE
final_table <- bind_rows(master_summary) %>%
arrange(forest_type, index, classification)
View(final_table)
write.csv(final_table, file.path(output_dir, paste0("Model_Comparison_", RUN_MODE, ".csv")), row.names = FALSE)
# ==========================================
# ==========================================
# ANALYSIS CONTROLLER (Toggle Switch)
# ==========================================
# Options: "GLOBAL" or "STRATIFIED"
# Locate the 'RUN_MODE' variable below and set it to one of two options:
#
#   "GLOBAL"     -> Use this to build a high-level cross data severity database.
#                   It groups all data into a single mass model for each severity index
#                   and classification grouping.
#                   Ideal for extracting universal broad thresholds.
#
#   "STRATIFIED" -> This option isolates target forest types (e.g., Ponderosa
#                   vs. Lodgepole), runs unique models for each, and outputs
#                   forest-specific metrics and thresholds.
#
#RUN_MODE <- "GLOBAL"
RUN_MODE <- "STRATIFIED"
# Severity indices
indices <- c("dnbr", "dnbr_off", "rbr", "rbr_off", "rdnbr", "rdnbr_off")
# ------------------------------------------------------------------------------
# USER-DEFINED FILTERS (Modify these to customize your runs!)
# ------------------------------------------------------------------------------
# GLOBAL MODE FILTERS:
FILTER_PHYS  <- "Conifer"    # EVT_PHYS classification of set to NULL
FILTER_STATE <- c("Colorado", "Wyoming", "Arizona", "Utah", "New Mexico")    # Set STATE (i.e. "COLORADO") or Set to NULL if you want all states
FILTER_FIRES <- NULL    # Set included fires (i.e. c("Calwood", "Cameron Peak")) or Set to NULL if you want all fires
FILTER_FOREST <- "Ponderosa Pine|Lodgepole|Douglas-fir|Juniper Woodland"    # Set EVT_GP_N regular expression (searches for exact text in whole string) or Set to NULL if you want all forest types
# STRATIFIED MODE FILTERS:
## Regular expression (searches for exact text in whole string)
## to pick which forest types run through the stratified loop.
TARGET_FOREST_TYPES <- "Ponderosa Pine|Lodgepole|Douglas-fir|Juniper Woodland|Spruce-Fir"
# ==============================================================================
# ==============================================================================
# ==========================================
# ==========================================
# ==========================================
# LOAD PACKAGES
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, dplyr, caret, ggpubr, broom, here)
# DATA SETUP
input_path  <- here("data")
output_dir  <- here("threshold_calibration", "OUTPUT")
# Ensure the local OUTPUT directory exists so the script doesn't throw a write error
if(!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
# Load your consolidated CSV from the local data folder
cbi_data <- read.csv(file.path(input_path, 'cbi_plots.csv')) %>% as_tibble()
heavy_data_path <- "E:/CFRI/Colorado_Fire_Severity/CBI/ANALYSIS/INPUT"
evt_csv <- read.csv(file.path(heavy_data_path, 'LF20_EVT_220.csv'))
bps_csv <- file.path(heavy_data_path, 'LF20_BPS_220.csv')
# Join vegetation attribute data for filter
cbi_data <- cbi_data %>%
mutate(EVT_Clean = as.integer(floor(EVT))) %>%
inner_join(evt_csv, by = c("EVT_Clean" = "VALUE"))
# CBI classification
cbi_data <- cbi_data %>%
mutate(
CBI_4 = case_when(
Cbi < 0.5               ~ "Unburned",
Cbi >= 0.5 & Cbi < 1.5  ~ "Low",
Cbi >= 1.5 & Cbi < 2.25 ~ "Moderate",
Cbi >= 2.25             ~ "High",
TRUE                    ~ NA_character_
),
CBI_3 = case_when(
Cbi < 1.25              ~ "Unburned/Low",
Cbi >= 1.25 & Cbi < 2.25~ "Moderate",
Cbi >= 2.25             ~ "High",
TRUE                    ~ NA_character_
),
CBI_high = case_when(
Cbi < 2.25              ~ "low/mod",
Cbi >= 2.25             ~ "high",
TRUE                    ~ NA_character_
)
)
# ==========================================
# DYNAMIC ENVIRONMENT FILTER
# ==========================================
if (RUN_MODE =="GLOBAL"){
filtered_data <- cbi_data %>%
filter(EVT_PHYS %in% FILTER_PHYS)
if(!is.null(FILTER_STATE)){
filtered_data <- filtered_data %>% filter(STATE %in% FILTER_STATE)
}
if(!is.null(FILTER_FIRES)){
filtered_data <- filtered_data %>% filter(FireName == FILTER_STATE)
}
if(!is.null(FILTER_FOREST)){
filtered_data <- filtered_data %>%
filter(stringr::str_detect(EVT_GP_N, stringr::regex(FILTER_FOREST, ignore_case = TRUE)))
}
data_list <- list("BroadConifer" = filtered_data)
} else if (RUN_MODE == "STRATIFIED"){
filtered_data <- cbi_data %>%
filter(stringr::str_detect(EVT_GP_N, stringr::regex(TARGET_FOREST_TYPES, ignore_case = TRUE)))
data_list <- split(filtered_data, filtered_data$EVT_GP_N)
}
# ==========================================
# CORES ANALYSIS RUNNER
# ==========================================
master_summary <- list()
schemes <- list(
"CBI_4"    = list(breaks = c(0.5, 1.5, 2.25),   levels = c("Unburned", "Low", "Moderate", "High")),
"CBI_3"    = list(breaks = c(1.25, 2.25),       levels = c("Unburned/Low", "Moderate", "High")),
"CBI_high" = list(breaks = c(2.25),             levels = c("low/mod", "high"))
)
for(forest_name in names(data_list)){
current_sub_df <- data_list[[forest_name]]
if(nrow(current_sub_df) < 15) next
for(s in indices){
# Prepare dynamic data for the loop
loop_df <- current_sub_df %>%
rename(sev_index = !!sym(s)) %>%
filter(!is.na(sev_index))
if(nrow(loop_df) < 10) next
# Regression model
mod <- lm(sev_index ~ poly(Cbi, 2, raw = TRUE), data = loop_df)
base_stats <- glance(mod)
# Evaluate each classification scheme
for(scheme_name in names(schemes)) {
cfg <- schemes[[scheme_name]]
# Calculate Thresholds
thresh_cbi <- data.frame(Cbi = cfg$breaks)
vals <- predict(mod, thresh_cbi)
# FIX: Run case_when INSIDE mutate to guarantee identical vector lengths
loop_df_classified <- loop_df %>%
mutate(predicted_sev = case_when(
scheme_name == "CBI_4" & sev_index < vals[1] ~ "Unburned",
scheme_name == "CBI_4" & sev_index >= vals[1] & sev_index < vals[2] ~ "Low",
scheme_name == "CBI_4" & sev_index >= vals[2] & sev_index < vals[3] ~ "Moderate",
scheme_name == "CBI_4" & sev_index >= vals[3] ~ "High",
scheme_name == "CBI_3" & sev_index < vals[1] ~ "Unburned/Low",
scheme_name == "CBI_3" & sev_index >= vals[1] & sev_index < vals[2] ~ "Moderate",
scheme_name == "CBI_3" & sev_index >= vals[2] ~ "High",
scheme_name == "CBI_high" & sev_index < vals[1] ~ "low/mod",
scheme_name == "CBI_high" & sev_index >= vals[1] ~ "high",
TRUE ~ NA_character_
))
# Confusion Matrix using the synchronized dataframe
conf_mat <- confusionMatrix(
factor(loop_df_classified$predicted_sev, levels = cfg$levels),
factor(loop_df_classified[[scheme_name]], levels = cfg$levels)
)
# Format the calculated thresholds into clean, readable text string
threshold_string <- case_when(
scheme_name == "CBI_4" ~ paste0(
"Unburned < ", round(vals[1], 0),
" | Low >= ",  round(vals[1], 0),
" | Mod >= ",  round(vals[2], 0),
" | High >= ", round(vals[3], 0)
),
scheme_name == "CBI_3" ~ paste0(
"Low/Unburned < ", round(vals[1], 0),
" | Mod >= ",      round(vals[1], 0),
" | High >= ",     round(vals[2], 0)
),
scheme_name == "CBI_high" ~ paste0(
"High >= ", round(vals[1], 0)
),
TRUE ~ NA_character_
)
# Extract stats, Accuracy and Kappa
stats_combined <- base_stats %>%
mutate(
forest_type = forest_name,
index = s,
classification = scheme_name,
n_plots = nrow(loop_df),
Accuracy = conf_mat$overall['Accuracy'],
Kappa = conf_mat$overall['Kappa'],
thresholds = threshold_string,
p_val_clean    = if_else(p.value < 0.0001, "< 0.0001", as.character(round(p.value, 4)))
) %>%
select(forest_type, index, classification, n_plots, r.squared, Accuracy, Kappa, p_val_clean, AIC, thresholds)
storage_key <- paste0(forest_name, "_", s, "_", scheme_name)
master_summary[[storage_key]] <- stats_combined
# Save individual Matrix output
safe_forest_name <- gsub("[^[:alnum:]]", "_", forest_name)
capture.output(conf_mat, file = file.path(output_dir, paste0(safe_forest_name, "_", s, "_", scheme_name, "_accuracy.txt")))
}
# PLOTTING Regressions
reg_plot <- ggplot(loop_df, aes(x = Cbi, y = sev_index)) +
geom_point(alpha = 0.4, color = "gray30") +
stat_smooth(method = "lm", formula = y ~ poly(x, 2), color = "firebrick") +
stat_regline_equation(label.y = max(loop_df$sev_index, na.rm=T) * 0.9) +
geom_vline(xintercept = 2.25, linetype = "dashed") +
labs(title = paste("Regression:", s), y = s, x = "Field CBI") +
theme_minimal() +
theme(text = element_text(family = "serif"))
ggsave(file.path(output_dir, paste0(RUN_MODE, "_", scheme_name, "_", s, ".png")), reg_plot)
}
}
# FINAL SUMMARY TABLE
final_table <- bind_rows(master_summary) %>%
arrange(forest_type, index, classification)
View(final_table)
write.csv(final_table, file.path(output_dir, paste0("Model_Comparison_", RUN_MODE, ".csv")), row.names = FALSE)
