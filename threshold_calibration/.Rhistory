# ==========================================
# ==========================================
# ANALYSIS CONTROLLER (Toggle Switch)
# ==========================================
# Options: "GLOBAL" or "STRATIFIED"
# Locate the 'RUN_MODE' variable below and set it to one of two options:
#
#   "GLOBAL"     -> Use this to build a high-level cross data severity database.
#                   It groups all data into a single mass model for each severity index
#                   and classification grouping.
#                   Ideal for extracting universal broad thresholds.
#
#   "STRATIFIED" -> This option isolates target forest types (e.g., Ponderosa
#                   vs. Lodgepole), runs unique models for each, and outputs
#                   forest-specific metrics and thresholds.
#
RUN_MODE <- "GLOBAL"
#RUN_MODE <- "STRATIFIED"
# Severity indices
indices <- c("dnbr", "dnbr_off", "rbr", "rbr_off", "rdnbr", "rdnbr_off")
# ------------------------------------------------------------------------------
# USER-DEFINED FILTERS (Modify these to customize your runs!)
# ------------------------------------------------------------------------------
# GLOBAL MODE FILTERS:
FILTER_PHYS  <- "Conifer"    # EVT_PHYS classification of set to NULL
FILTER_STATE <- c("Colorado", "Wyoming", "Arizona", "Utah", "New Mexico")    # Set STATE (i.e. "COLORADO") or Set to NULL if you want all states
FILTER_FIRES <- NULL    # Set included fires (i.e. c("Calwood", "Cameron Peak")) or Set to NULL if you want all fires
FILTER_FOREST <- "Ponderosa Pine|Lodgepole|Douglas-fir|Juniper Woodland"    # Set EVT_GP_N regular expression (searches for exact text in whole string) or Set to NULL if you want all forest types
# STRATIFIED MODE FILTERS:
## Regular expression (searches for exact text in whole string)
## to pick which forest types run through the stratified loop.
TARGET_FOREST_TYPES <- "Ponderosa Pine|Lodgepole|Douglas-fir|Juniper Woodland|Spruce-Fir"
# ==============================================================================
# ==============================================================================
# ==========================================
# ==========================================
# ==========================================
# LOAD PACKAGES
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, dplyr, caret, ggpubr, broom, here)
# DATA SETUP
input_path  <- here("data")
output_dir  <- here("threshold_calibration", "OUTPUT")
input_path
output_dir
if(!dir.exists(output_dir)) dir.create(output_dir, recursive = TRUE)
cbi_data <- read.csv(file.path(input_path, 'cbi_plots.csv')) %>% as_tibble()
heavy_data_path <- "E:/CFRI/Colorado_Fire_Severity/CBI/ANALYSIS/INPUT"
evt_csv <- read.csv(file.path(heavy_data_path, 'LF20_EVT_220.csv'))
bps_csv <- file.path(heavy_data_path, 'LF20_BPS_220.csv')
cbi_data <- cbi_data %>%
mutate(EVT_Clean = as.integer(floor(EVT))) %>%
inner_join(evt_csv, by = c("EVT_Clean" = "VALUE"))
